<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Push" targetNamespace="urn:retail-banking:marketing-notification">
  <bpmn:process id="Process_Push" name="Решение об отправке одного маркетингового push-уведомления" isExecutable="false">
    <bpmn:laneSet id="Lanes">
      <bpmn:lane id="Lane_crm" name="CRM-платформа">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndS</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_dec" name="Сервис решений">
        <bpmn:flowNodeRef>B02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B05</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ml" name="ML-сервис">
        <bpmn:flowNodeRef>B03</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_data" name="Контур данных">
        <bpmn:flowNodeRef>B09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndF</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Срок отправки">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="B01" name="B01 · Запросить решение об отправке">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G2" name="Действие?">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="B06" name="B06 · Отправить уведомление">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="B07" name="B07 · Перенести попытку">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="B08" name="B08 · Отменить отправку">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndD" name="Отложено">
      <bpmn:incoming>F12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndS" name="Отменено">
      <bpmn:incoming>F13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="B02" name="B02 · Запросить прогноз">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G1" name="Прогноз пригоден?">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="B04" name="B04 · Применить запасное правило">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="B05" name="B05 · Проверить согласие и лимит; выбрать и записать действие">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="B03" name="B03 · Рассчитать риск отписки или жалобы">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="B09" name="B09 · Связать события с решением">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="B10" name="B10 · Сформировать метку или исключить пример">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndF" name="Исход учтён">
      <bpmn:incoming>F16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="B01" />
    <bpmn:sequenceFlow id="F2" sourceRef="B01" targetRef="B02" />
    <bpmn:sequenceFlow id="F3" sourceRef="B02" targetRef="B03" />
    <bpmn:sequenceFlow id="F4" sourceRef="B03" targetRef="G1" />
    <bpmn:sequenceFlow id="F5" sourceRef="G1" targetRef="B05" name="Да: получен пригодный прогноз" />
    <bpmn:sequenceFlow id="F6" sourceRef="G1" targetRef="B04" name="Нет" />
    <bpmn:sequenceFlow id="F7" sourceRef="B04" targetRef="B05" />
    <bpmn:sequenceFlow id="F8" sourceRef="B05" targetRef="G2" name="Решение и причина" />
    <bpmn:sequenceFlow id="F9" sourceRef="G2" targetRef="B06" name="SEND" />
    <bpmn:sequenceFlow id="F10" sourceRef="G2" targetRef="B07" name="DEFER" />
    <bpmn:sequenceFlow id="F11" sourceRef="G2" targetRef="B08" name="SUPPRESS" />
    <bpmn:sequenceFlow id="F12" sourceRef="B07" targetRef="EndD" />
    <bpmn:sequenceFlow id="F13" sourceRef="B08" targetRef="EndS" />
    <bpmn:sequenceFlow id="F14" sourceRef="B06" targetRef="B09" name="Факт отправки и последующие события" />
    <bpmn:sequenceFlow id="F15" sourceRef="B09" targetRef="B10" name="Наблюдение завершено" />
    <bpmn:sequenceFlow id="F16" sourceRef="B10" targetRef="EndF" />
    <bpmn:textAnnotation id="RiskNote">
      <bpmn:text>B05. Приоритет условий при выборе действия
1. Нет согласия или невозможно проверить согласие либо лимит → отменить.
2. Нет пригодного прогноза или признаки старше 60 с → отложить.
3. Пригодный прогноз: риск ≥ 0,15 → отменить.
4. Риск от 0,05 до 0,15 (не включая 0,15) → отложить.
5. Риск &lt; 0,05: лимит исчерпан → отложить; есть резерв → отправить.</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:process>
  <bpmn:collaboration id="Collaboration">
    <bpmn:participant id="Bank" name="Розничный банк: решение об отправке уведомления" processRef="Process_Push" />
  </bpmn:collaboration>
