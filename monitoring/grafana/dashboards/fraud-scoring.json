          "rawSql": "\r\nSELECT\r\n    model_version,\r\n    COUNT(*) AS transactions_count,\r\n    ROUND(\r\n        100.0 * AVG(fraud_flag), 2\r\n    ) AS fraud_percentage,\r\n    ROUND(\r\n        AVG(score)::numeric, 4\r\n    ) AS average_score\r\nFROM scoring_results\r\nGROUP BY model_version\r\nORDER BY transactions_count DESC;\r\n",
