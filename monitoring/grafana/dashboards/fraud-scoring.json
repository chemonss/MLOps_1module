    {
      "id": 8,
      "title": "Filtered transaction throughput (TPS)",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n    $__timeGroupAlias(created_at, '1m'),\n    COUNT(*)::double precision / 60.0 AS \"TPS\"\nFROM scoring_results\nWHERE $__timeFilter(created_at)\n  AND us_state IN (${state:sqlstring})\n  AND merch IN (${merchant:sqlstring})\nGROUP BY 1\nORDER BY 1;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 9,
      "title": "Fraud score density by state and merchant",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH buckets AS (\n  SELECT LEAST(19, FLOOR(score * 20)::integer) AS b\n  FROM scoring_results WHERE us_state IN (${state:sqlstring}) AND merch IN (${merchant:sqlstring})\n), counts AS (\n  SELECT b, COUNT(*)::double precision AS n FROM buckets GROUP BY b\n)\nSELECT CONCAT(TO_CHAR(b * 0.05, 'FM0.00'), '–', TO_CHAR((b + 1) * 0.05, 'FM0.00')) AS score_bucket,\n       n / NULLIF(SUM(n) OVER () * 0.05, 0) AS density\nFROM counts ORDER BY b"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "showValue": "auto",
        "groupWidth": 0.7,
        "barWidth": 0.8,
        "barRadius": 0,
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 0,
        "showLegend": false
      }
    },
    {
      "id": 10,
      "title": "Fraud fraction by product category (last 1000)",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH last_1000 AS (\n SELECT cat_id, fraud_flag FROM scoring_results\n WHERE us_state IN (${state:sqlstring}) AND merch IN (${merchant:sqlstring}) AND cat_id IS NOT NULL\n ORDER BY created_at DESC, id DESC LIMIT 1000\n)\nSELECT cat_id, AVG(fraud_flag::double precision) AS fraud_fraction\nFROM last_1000 GROUP BY cat_id ORDER BY fraud_fraction DESC, cat_id"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "showValue": "auto",
        "groupWidth": 0.7,
        "barWidth": 0.8,
        "barRadius": 0,
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 0,
        "showLegend": false
      }
    },
    {
      "id": 11,
      "title": "Average fraud score by merchant (business)",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 41,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT merch AS merchant, AVG(score) AS average_fraud_score\nFROM scoring_results WHERE us_state IN (${state:sqlstring}) AND merch IN (${merchant:sqlstring})\nGROUP BY merch HAVING COUNT(*) >= 2\nORDER BY average_fraud_score DESC, merchant LIMIT 15"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "showValue": "auto",
